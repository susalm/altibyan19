    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
